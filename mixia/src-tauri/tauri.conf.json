{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mixia",
  "version": "0.1.0",
  "identifier": "com.local.mixia",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "秘匣 · 本地加密保险库",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#0c0e14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; form-action 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
